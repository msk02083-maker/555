rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidReservation(data) {
      return data.keys().hasAll(['name', 'phone', 'menu', 'quantity', 'date', 'time', 'status', 'createdAt'])
        && data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 50
        && data.menu is string && data.menu.size() <= 200
        && data.quantity is number
        && data.date is string && data.date.size() <= 20
        && data.time is string && data.time.size() <= 20
        && (data.keys().hasAll(['requests']) == false || (data.requests is string && data.requests.size() <= 1000))
        && data.status in ['pending', 'preparing', 'completed'];
    }

    match /reservations/{reservationId} {
      // Allow anyone to create a reservation. Check timestamp validity.
      allow create: if isValidReservation(incoming())
                    && incoming().createdAt == request.time
                    && incoming().status == 'pending';
      
      // Only admins can read reservations
      allow read: if isAdmin();
      
      // Only admins can update the status
      allow update: if isAdmin() 
                    && isValidReservation(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
                    
      // Only admins can delete (optional, but good for cleanup)
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      // Only read by themselves to check existence
      allow read: if request.auth.uid == adminId;
      // Do not allow writes from the client, add admins manually in console or using another secure method
    }
  }
}
